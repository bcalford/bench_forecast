# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Inngest: set INNGEST_DEV=1 locally; the two keys are only needed when deployed
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Model and embedding providers (used from phase 2 on)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# CourtListener (courtlistener.com → profile → Developer Tools). Raises the API limit from 5/min to 5,000/hour.
COURTLISTENER_TOKEN=

# Global daily spending cap for new runs, in US dollars
DAILY_SPEND_CAP_USD=25
